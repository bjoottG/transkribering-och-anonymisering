# Kopiera till .env och anpassa vid behov. Alla värden nedan är standardvärden.

# Modeller
WHISPER_MODEL=KBLab/kb-whisper-large
NER_MODEL=KB/bert-base-swedish-cased-ner

# Entitetstyper som ersätts vid anonymisering (kommaseparerat).
# Möjliga: PER, LOC, ORG, TME, EVN, WRK, OBJ, MSR, PRC
NER_ENTITY_TYPES=PER,LOC,ORG

# Lägsta konfidens (0–1) för att en NER-entitet ska ersättas
NER_SCORE_THRESHOLD=0.70

# Beräkningsenhet: auto | cuda | cpu  (auto = cuda om tillgänglig)
DEVICE=auto

# Hugging Face-cache (kataloger skapas vid behov)
HF_HOME=./hf_cache

# Maxstorlek för uppladdade filer i MB (standard 2 GB)
MAX_FILE_SIZE_MB=2048

# Hur länge jobb (uppladdningar + resultat) sparas innan automatisk rensning, i timmar
CLEANUP_HOURS=24

# Serverport
PORT=8000
