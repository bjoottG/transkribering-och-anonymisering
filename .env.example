# Kopiera till .env och anpassa vid behov. Alla värden nedan är standardvärden.

# Modeller
WHISPER_MODEL=KBLab/kb-whisper-large
NER_MODEL=KB/bert-base-swedish-cased-ner

# Entitetstyper som ersätts vid anonymisering (kommaseparerat).
# Möjliga: PER, LOC, ORG, TME, EVN, WRK, OBJ, MSR, PRC
NER_ENTITY_TYPES=PER,LOC,ORG

# Lägsta konfidens (0–1) för att en NER-entitet ska ersättas
NER_SCORE_THRESHOLD=0.70

# Beräkningsenhet: auto | cuda | cpu  (auto = cuda om tillgänglig)
DEVICE=auto

# Hugging Face-cache (kataloger skapas vid behov)
HF_HOME=./hf_cache

# Maxstorlek för uppladdade filer i MB (standard 2 GB)
MAX_FILE_SIZE_MB=2048

# Hur länge jobb (uppladdningar + resultat) sparas innan automatisk rensning, i timmar
CLEANUP_HOURS=24

# Serverport
PORT=8000

# --- Skärmbildsbeskrivning av filmer (valfritt) ---
# Beskriver skärminnehåll i filmfiler med Claude API och bygger en tidslinje
# (tal + skärm). OBS: detta är appens ENDA externa anrop — bildrutor (aldrig
# ljud/tal/dokument) skickas till Anthropics API. Aktiveras genom att sätta
# en API-nyckel från https://console.anthropic.com
#ANTHROPIC_API_KEY=sk-ant-...

# Modell för bildbeskrivning
VISION_MODEL=claude-opus-5

# Scendetekteringströskel (0–1). Lågt värde behövs för skärminspelningar,
# där ett "scenbyte" bara ändrar några procent av pixlarna.
SCENE_THRESHOLD=0.04

# Fallback: ta en bild var N:e sekund där inget scenbyte fångats
FRAME_INTERVAL=20

# Maxantal bilder som beskrivs per film (kostnadstak)
FRAME_MAX=60
